spring.application.name=demo_backend
server.port=8080

# Database configuration via environment variables
# Copy .env.example → .env and fill in your credentials, or set env vars directly
spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/words_demo?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai}
spring.datasource.username=${DB_USERNAME:root}
spring.datasource.password=${DB_PASSWORD:}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
